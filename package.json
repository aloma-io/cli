{
  "name": "@aloma.io/aloma",
  "version": "0.0.2",
  "description": "Aloma CLI and utility package",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "aloma": "./src/cli.js"
  },
  "files": [
    "src/",
    "examples/",
    "docs/",
    "config/",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/test-openid.js",
    "setup": "npm link",
    "auth": "node src/cli.js auth",
    "format": "prettier --write \"src/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\"",
    "prepublishOnly": "npm run format:check",
    "postinstall": "node src/cli.js setup || echo 'CLI setup will be configured on first use'"
  },
  "keywords": [
    "aloma",
    "cli",
    "automation",
    "workflow",
    "api"
  ],
  "author": "Aloma Team",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aloma-io/cli.git"
  },
  "bugs": {
    "url": "https://github.com/aloma-io/cli/issues"
  },
  "homepage": "https://github.com/aloma-io/cli#readme",
  "dependencies": {
    "axios": "^1.9.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "diff": "^8.0.2",
    "jose": "^5.2.0",
    "js-yaml": "^4.1.0",
    "keytar": "^7.9.0",
    "node-fetch": "^2.6.7",
    "open": "^8.4.2",
    "openid-client": "~4.9.1",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "supabase": "^2.20.12"
  }
}
